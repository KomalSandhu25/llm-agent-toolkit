# --- LLM provider ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# --- Agent behavior ---
MAX_ITERATIONS=10
MAX_TOOL_RETRIES=2
AGENT_VERBOSE=true

# --- Memory backend ---
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=86400
MAX_CONVERSATION_TURNS=50

# --- Logging ---
LOG_LEVEL=INFO

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
